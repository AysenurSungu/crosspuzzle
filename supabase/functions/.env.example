# Lokal Edge Function testleri için ortam değişkenleri.
# Bu dosyayı `.env` olarak kopyala ve değeri doldur:
#   cp supabase/functions/.env.example supabase/functions/.env
#
# `.env` repoya GİRMEZ (.gitignore ile ignore edilir). Deploy'da bu değer
# Supabase panelindeki Edge Function Secrets'tan gelir (bu dosyadan değil).
#
# Lokal çalıştırma:
#   supabase functions serve generate-puzzle --no-verify-jwt --env-file ./supabase/functions/.env

ANTHROPIC_API_KEY=sk-ant-...
